<script>
  // همگام‌سازی تب‌ها، اسنپ اسکرول افقی و نشانگرهای نقطه‌ای در نسخه موبایل
  function setupTrustMobileInteractions() {
    const slider = document.getElementById('trust-cards-slider');
    const tabs = document.querySelectorAll<HTMLButtonElement>('.trust-tab-btn');
    const dots = document.querySelectorAll<HTMLElement>('#trust-dots span');
    if (!slider || tabs.length === 0) return;

    const cards = slider.querySelectorAll<HTMLElement>('[data-card-index]');

    function updateActive(index: number) {
      tabs.forEach((tab, i) => {
        if (i === index) {
          tab.className = 'trust-tab-btn active px-3.5 py-1.5 rounded-full text-xs font-bold transition-all bg-accent-500 text-primary-950 shadow-md';
        } else {
          tab.className = 'trust-tab-btn px-3.5 py-1.5 rounded-full text-xs font-bold transition-all bg-slate-900/90 text-slate-300 border border-slate-700/80';
        }
      });
      dots.forEach((dot, i) => {
        if (i === index) {
          dot.className = 'w-6 h-1.5 rounded-full bg-accent-400 transition-all';
        } else {
          dot.className = 'w-1.5 h-1.5 rounded-full bg-slate-700 transition-all';
        }
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const idx = Number(tab.getAttribute('data-trust-tab'));
        const targetCard = cards[idx];
        if (targetCard) {
          targetCard.scrollIntoView({
            behavior: 'smooth',
            block: 'nearest',
            inline: 'start',
          });
          updateActive(idx);
        }
      });
    });

    slider.addEventListener('scroll', () => {
      let closestIdx = 0;
      let minDiff = Infinity;
      const sliderCenter = slider.scrollLeft + slider.clientWidth / 2;

      cards.forEach((card, idx) => {
        const cardCenter = card.offsetLeft + card.clientWidth / 2;
        const diff = Math.abs(sliderCenter - cardCenter);
        if (diff < minDiff) {
          minDiff = diff;
          closestIdx = idx;
        }
      });

      updateActive(closestIdx);
    }, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTrustMobileInteractions);
  } else {
    setupTrustMobileInteractions();
  }
</script>

