---
---

<div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200" id="calc-commission-box">
  <div class="flex items-center gap-3 mb-6">
    <div class="w-10 h-10 rounded-xl bg-accent-100 text-accent-600 flex items-center justify-center font-bold text-lg">
      💰
    </div>
    <div>
      <h3 class="text-xl font-bold text-primary-900">محاسبه آنلاین کمیسیون املاک</h3>
      <p class="text-xs text-slate-500">بر اساس تعرفه رسمی صنف مشاورین املاک خوزستان و مالیات ارزش افزوده</p>
    </div>
  </div>

  <div class="space-y-4">
    <!-- مبلغ معامله -->
    <div>
      <label for="dealInput" class="block text-xs font-bold text-slate-700 mb-1">
        مبلغ کل معامله (تومان):
      </label>
      <input
        type="number"
        id="dealInput"
        value="3000000000"
        step="100000000"
        min="0"
        dir="ltr"
        class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-accent-500 focus:ring-2 focus:ring-accent-400/20 text-slate-900 text-sm font-mono text-end"
      />
      <div id="dealInputFormatted" class="text-[11px] text-accent-600 font-bold mt-1 text-end">
        ۳٬۰۰۰٬۰۰۰٬۰۰۰ تومان
      </div>
    </div>

    <!-- نوع معامله -->
    <div>
      <label for="dealTypeSelect" class="block text-xs font-bold text-slate-700 mb-1">
        نوع معامله:
      </label>
      <select
        id="dealTypeSelect"
        class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-accent-500 focus:ring-2 focus:ring-accent-400/20 text-slate-900 text-sm bg-white"
      >
        <option value="buy_sell">خرید و فروش (۰٫۵ درصد از طرفین)</option>
        <option value="rent">رهن و اجاره (بر مبنای اجاره ماهانه)</option>
      </select>
    </div>

    <!-- نتایج محاسبه -->
    <div class="bg-primary-50 rounded-2xl p-4 border border-primary-100 space-y-2.5 text-xs sm:text-sm">
      <div class="flex justify-between items-center text-slate-600">
        <span>سهم خریدار / مستأجر:</span>
        <span id="resBuyer" class="font-bold font-mono text-slate-800">۱۵٬۰۰۰٬۰۰۰ تومان</span>
      </div>
      <div class="flex justify-between items-center text-slate-600">
        <span>سهم فروشنده / مالک:</span>
        <span id="resSeller" class="font-bold font-mono text-slate-800">۱۵٬۰۰۰٬۰۰۰ تومان</span>
      </div>
      <div class="flex justify-between items-center text-slate-600">
        <span>مالیات بر ارزش افزوده (۱۰٪):</span>
        <span id="resTax" class="font-bold font-mono text-slate-800">۳٬۰۰۰٬۰۰۰ تومان</span>
      </div>
      <div class="pt-2 border-t border-primary-200/60 flex justify-between items-center text-primary-900 font-extrabold text-sm sm:text-base">
        <span>مجموع کل حق‌الزحمه:</span>
        <span id="resTotal" class="text-primary-700 font-mono">۳۳٬۰۰۰٬۰۰۰ تومان</span>
      </div>
    </div>
  </div>
</div>

<script>
  function formatFa(num: number): string {
    return new Intl.NumberFormat('fa-IR').format(Math.round(num)) + ' تومان';
  }

  function updateCommission() {
    const input = document.getElementById('dealInput') as HTMLInputElement | null;
    const typeSelect = document.getElementById('dealTypeSelect') as HTMLSelectElement | null;
    const resBuyer = document.getElementById('resBuyer');
    const resSeller = document.getElementById('resSeller');
    const resTax = document.getElementById('resTax');
    const resTotal = document.getElementById('resTotal');
    const formattedHint = document.getElementById('dealInputFormatted');

    if (!input || !typeSelect || !resBuyer || !resSeller || !resTax || !resTotal) return;

    const val = parseFloat(input.value) || 0;
    if (formattedHint) {
      formattedHint.innerText = formatFa(val);
    }

    const isBuySell = typeSelect.value === 'buy_sell';
    const rate = isBuySell ? 0.005 : 0.25;
    const oneSide = Math.round(val * rate);
    const subtotal = oneSide * 2;
    const tax = Math.round(subtotal * 0.1);
    const total = subtotal + tax;

    resBuyer.innerText = formatFa(oneSide);
    resSeller.innerText = formatFa(oneSide);
    resTax.innerText = formatFa(tax);
    resTotal.innerText = formatFa(total);
  }

  document.getElementById('dealInput')?.addEventListener('input', updateCommission);
  document.getElementById('dealTypeSelect')?.addEventListener('change', updateCommission);
  updateCommission();
</script>
