---
import agencyData from '../data/agency.json';

interface Props {
  baseUrl: string;
}

const { baseUrl } = Astro.props;
---

<footer class="bg-primary-900 text-slate-300 pt-16 pb-8 border-t-4 border-accent-500">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      <!-- درباره آژانس -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <span class="w-8 h-8 rounded-lg bg-accent-500 text-primary-900 font-bold flex items-center justify-center text-sm">
            ام
          </span>
          <span class="text-xl font-extrabold text-accent-400">املاک امید</span>
        </div>
        <p class="text-sm leading-relaxed text-slate-300 mb-4">
          {agencyData.slogan}. بیش از یک دهه سابقه درخشان در انجام معاملات امن، ارزیابی کارشناسی و ارائه مشاوره حقوقی مسکن.
        </p>
        <div class="text-xs text-accent-400 font-semibold">
          تأسیس: سال {agencyData.foundedYear} | بیش از {agencyData.stats.activeAdvisors} مشاور فعال
        </div>
      </div>

      <!-- لینک‌های سریع -->
      <div>
        <h4 class="text-base font-bold text-white mb-4 border-s-2 border-accent-500 ps-2">دسترسی سریع</h4>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href={`${baseUrl}/properties/`} class="hover:text-accent-400 transition-colors">املاک فروشی گلستان</a>
          </li>
          <li>
            <a href={`${baseUrl}/#calculators`} class="hover:text-accent-400 transition-colors">ماشین‌حساب کمیسیون مسکن</a>
          </li>
          <li>
            <a href={`${baseUrl}/#consultation`} class="hover:text-accent-400 transition-colors">درخواست مشاوره خرید یا فروش</a>
          </li>
          <li>
            <a href={`${baseUrl}/blog/`} class="hover:text-accent-400 transition-colors">مقالات و راهنمای خرید ملک</a>
          </li>
          <li>
            <a href={`${baseUrl}/about/`} class="hover:text-accent-400 transition-colors">معرفی مشاوران و تیم املاک امید</a>
          </li>
        </ul>
      </div>

      <!-- اطلاعات تماس -->
      <div>
        <h4 class="text-base font-bold text-white mb-4 border-s-2 border-accent-500 ps-2">ارتباط با دفتر</h4>
        <p class="text-sm leading-relaxed mb-3 flex items-start gap-2">
          <svg class="w-4 h-4 text-accent-400 mt-1 shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
          </svg>
          <span>{agencyData.address}</span>
        </p>
        <p class="text-sm mb-2 flex items-center gap-2">
          <svg class="w-4 h-4 text-accent-400 shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z" />
          </svg>
          <span>تلفن دفتر:</span>
          <span class="text-white font-mono" dir="ltr">{agencyData.phone}</span>
        </p>
        <p class="text-sm mb-2 flex items-center gap-2">
          <svg class="w-4 h-4 text-accent-400 shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path d="M7 2a2 2 0 00-2 2v12a2 2 0 002 2h6a2 2 0 002-2V4a2 2 0 00-2-2H7zm3 14a1 1 0 100-2 1 1 0 000 2z" />
          </svg>
          <span>تلفن همراه:</span>
          <span class="text-white font-mono" dir="ltr">{agencyData.mobile}</span>
        </p>
        <p class="text-xs text-slate-400 mt-2 flex items-center gap-2">
          <svg class="w-3.5 h-3.5 text-accent-400/80 shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
          </svg>
          <span>ساعات کاری: {agencyData.workingHours}</span>
        </p>
      </div>

      <!-- صفحات حقوقی و مجوز -->
      <div>
        <h4 class="text-base font-bold text-white mb-4 border-s-2 border-accent-500 ps-2">قوانین و امنیت</h4>
        <p class="text-sm text-slate-300 mb-4">
          کلیه قراردادها تحت نظارت کارشناس رسمی و منطبق بر تعرفه اتحادیه صنف مشاورین املاک تنظیم می‌گردد.
        </p>
        <div class="flex flex-col gap-2 text-xs">
          <a href={`${baseUrl}/privacy/`} class="text-slate-300 hover:text-accent-400 transition-colors">
            • حریم خصوصی و امنیت اطلاعات
          </a>
          <a href={`${baseUrl}/terms/`} class="text-slate-300 hover:text-accent-400 transition-colors">
            • شرایط و قوانین استفاده از خدمات
          </a>
        </div>
      </div>
    </div>

    <!-- کپی‌رایت -->
    <div class="pt-8 border-t border-slate-800 text-center text-xs text-slate-400 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        تمامی حقوق مادی و معنوی متعلق به آژانس املاک امید (گلستان اهواز) می‌باشد © ۱۴۰۳
      </div>
      <div class="text-slate-400">
        طراحی و پیاده‌سازی مدرن برای گیت‌هاب پیجز
      </div>
    </div>
  </div>
</footer>
