---
import type { Property } from '../types/property';
import StatusBadge from './StatusBadge.astro';
import { formatToman } from '../utils/calculators';

interface Props {
  property: Property;
  baseUrl: string;
}

const { property, baseUrl } = Astro.props;
const primaryImage = property.images.find(img => img.isPrimary) || property.images[0];
const isSold = property.status === 'sold';
---

<article class={`bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-200 flex flex-col group ${isSold ? 'opacity-90' : 'hover:-translate-y-1'}`}>
  <!-- عکس شاخص با بج وضعیت -->
  <div class="relative aspect-video overflow-hidden bg-slate-100">
    <img
      src={primaryImage.url}
      alt={primaryImage.alt}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    <div class="absolute top-3 end-3 z-10">
      <StatusBadge status={property.status} label={property.statusLabel} />
    </div>
    <div class="absolute bottom-3 start-3 bg-primary-900/80 backdrop-blur-sm text-accent-300 text-xs px-2.5 py-1 rounded-md font-semibold">
      {property.propertyTypeLabel}
    </div>
  </div>

  <!-- بدنه کارت -->
  <div class="p-5 flex flex-col flex-grow">
    <h3 class="text-lg font-bold text-slate-900 group-hover:text-primary-700 transition-colors line-clamp-1 mb-1">
      <a href={`${baseUrl}/properties/${property.slug}/`} class="focus:outline-none focus:underline">
        {property.title}
      </a>
    </h3>

    <p class="text-xs text-slate-500 mb-4 flex items-center gap-1">
      <svg class="w-3.5 h-3.5 text-accent-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
      </svg>
      {property.address}
    </p>

    <!-- متاداده فنی -->
    <div class="grid grid-cols-3 gap-2 py-3 px-2 bg-slate-50 rounded-xl mb-4 text-xs text-slate-700 border border-slate-100">
      <div class="text-center">
        <span class="block text-slate-400 text-[11px] mb-0.5">متراژ</span>
        <span class="font-bold">{property.areaSqm} م²</span>
      </div>
      <div class="text-center border-x border-slate-200">
        <span class="block text-slate-400 text-[11px] mb-0.5">تعداد اتاق</span>
        <span class="font-bold">{property.bedrooms} خواب</span>
      </div>
      <div class="text-center">
        <span class="block text-slate-400 text-[11px] mb-0.5">سال ساخت</span>
        <span class="font-bold">{property.yearBuilt}</span>
      </div>
    </div>

    <!-- قیمت و اکشن -->
    <div class="mt-auto pt-3 border-t border-slate-100 flex items-center justify-between">
      <div>
        <div class="text-xs text-slate-400">قیمت کل:</div>
        <div class={`text-base sm:text-lg font-extrabold ${isSold ? 'line-through text-slate-400' : 'text-primary-700'}`}>
          {formatToman(property.priceToman)}
        </div>
      </div>
      <a
        href={`${baseUrl}/properties/${property.slug}/`}
        class="inline-flex items-center justify-center text-xs font-bold px-3.5 py-2 rounded-lg bg-primary-50 text-primary-700 hover:bg-primary-700 hover:text-white transition-colors border border-primary-100"
      >
        مشاهده جزئیات
      </a>
    </div>
  </div>
</article>
