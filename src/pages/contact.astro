---
import Layout from '../layouts/Layout.astro';
import agencyData from '../data/agency.json';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="تماس با ما | آدرس و اطلاعات ارتباطی املاک امید اهواز"
  description="اطلاعات تماس، تلفن، آدرس دفتر آژانس املاک امید در خیابان فروردین محله گلستان اهواز، ساعات کاری و نقشه مسیریابی حضوری."
>
  <!-- هدر صفحه تماس -->
  <section class="bg-primary-900 text-white py-12 border-b-2 border-accent-500/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-2xl sm:text-4xl font-black mb-3">
        تماس با <span class="text-accent-400">املاک امید</span>
      </h1>
      <p class="text-sm text-slate-300 max-w-xl mx-auto">
        مشتاقانه آماده پاسخگویی به پرسش‌های شما، ارائه مشاوره حضوری یا دریافت فایل ملکی شما هستیم.
      </p>
    </div>
  </section>

  <!-- محتوای تماس -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <!-- ستون اطلاعات تماس و نقشه -->
        <div class="space-y-8">
          <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200">
            <h2 class="text-lg font-bold text-primary-900 mb-6 border-s-4 border-accent-500 ps-3">
              اطلاعات ارتباطی دفتر مرکزی
            </h2>

            <div class="space-y-4 text-sm">
              <div class="flex items-start gap-3">
                <div class="w-9 h-9 rounded-xl bg-accent-100 text-accent-700 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div>
                  <strong class="block text-slate-800">آدرس دفتر:</strong>
                  <span class="text-slate-600">{agencyData.address}</span>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-9 h-9 rounded-xl bg-accent-100 text-accent-700 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z" />
                  </svg>
                </div>
                <div>
                  <strong class="block text-slate-800">تلفن‌های ثابت:</strong>
                  <span class="text-slate-600 font-mono" dir="ltr">{agencyData.phone}</span>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-9 h-9 rounded-xl bg-accent-100 text-accent-700 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M7 2a2 2 0 00-2 2v12a2 2 0 002 2h6a2 2 0 002-2V4a2 2 0 00-2-2H7zm3 14a1 1 0 100-2 1 1 0 000 2z" />
                  </svg>
                </div>
                <div>
                  <strong class="block text-slate-800">تلفن همراه مدیریت:</strong>
                  <span class="text-slate-600 font-mono" dir="ltr">{agencyData.mobile}</span>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-9 h-9 rounded-xl bg-accent-100 text-accent-700 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div>
                  <strong class="block text-slate-800">ساعات کاری و پاسخگویی:</strong>
                  <span class="text-slate-600">{agencyData.workingHours}</span>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-9 h-9 rounded-xl bg-accent-100 text-accent-700 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                    <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
                  </svg>
                </div>
                <div>
                  <strong class="block text-slate-800">ایمیل پشتیبانی:</strong>
                  <span class="text-slate-600 font-mono">{agencyData.email}</span>
                </div>
              </div>
            </div>
          </div>

          <!-- نقشه دفتر املاک امید در محله گلستان -->
          <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200">
            <h3 class="text-base font-bold text-primary-900 mb-4">
              موقعیت مکانی دفتر روی نقشه
            </h3>
            <div
              id="officeMap"
              class="h-72 w-full rounded-2xl overflow-hidden border border-slate-200"
              data-lat={agencyData.coordinates.lat}
              data-lng={agencyData.coordinates.lng}
            ></div>
          </div>
        </div>

        <!-- ستون فرم پیام مستقیم -->
        <div class="bg-white rounded-3xl p-6 sm:p-10 shadow-sm border border-slate-200">
          <h2 class="text-xl font-extrabold text-primary-900 mb-2">
            ارسال پیام یا طرح پرسش
          </h2>
          <p class="text-xs text-slate-500 mb-6">
            سؤال، انتقاد یا تقاضای خود را بنویسید؛ همکاران ما در دبیرخانه در اسرع وقت پاسخ خواهند داد.
          </p>

          <form action={`${baseUrl}/thanks/`} method="GET" class="space-y-4">
            <input type="hidden" name="source" value="contact_page" />

            <div>
              <label for="cName" class="block text-xs font-bold text-slate-700 mb-1">نام و نام خانوادگی *</label>
              <input
                type="text"
                id="cName"
                name="name"
                required
                placeholder="مثال: محمد حسینی"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-accent-500 text-sm"
              />
            </div>

            <div>
              <label for="cPhone" class="block text-xs font-bold text-slate-700 mb-1">شماره تماس همراه *</label>
              <input
                type="tel"
                id="cPhone"
                name="phone"
                required
                placeholder="۰۹۱۲۳۴۵۶۷۸۹"
                dir="ltr"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-accent-500 text-sm font-mono text-end"
              />
            </div>

            <div>
              <label for="cSubject" class="block text-xs font-bold text-slate-700 mb-1">موضوع پیام</label>
              <select id="cSubject" name="subject" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm bg-white">
                <option value="general">مشاوره عمومی ملکی</option>
                <option value="evaluation">تقاضای کارشناسی قیمت ملک</option>
                <option value="cooperation">همکاری با مشاورین</option>
                <option value="feedback">پیشنهادات و انتقادات</option>
              </select>
            </div>

            <div>
              <label for="cMessage" class="block text-xs font-bold text-slate-700 mb-1">متن پیام *</label>
              <textarea
                id="cMessage"
                name="message"
                required
                rows="4"
                placeholder="متن پیام خود را بنویسید..."
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-accent-500 text-sm"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full bg-primary-700 hover:bg-primary-800 text-white font-bold py-3 px-6 rounded-xl text-sm transition-colors shadow-md"
            >
              ارسال پیام به دفتر املاک امید
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  window.addEventListener('DOMContentLoaded', () => {
    const mapContainer = document.getElementById('officeMap');
    if (mapContainer && (window as any).L) {
      const lat = parseFloat(mapContainer.getAttribute('data-lat') || '31.3055');
      const lng = parseFloat(mapContainer.getAttribute('data-lng') || '48.6645');

      const map = (window as any).L.map('officeMap').setView([lat, lng], 15);

      (window as any).L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© نقشه دفتر املاک امید گلستان اهواز',
        maxZoom: 18,
      }).addTo(map);

      const marker = (window as any).L.marker([lat, lng]).addTo(map);
      marker.bindPopup('<b>دفتر مرکزی املاک امید</b><br>خیابان فروردین گلستان').openPopup();
    }
  });
</script>
