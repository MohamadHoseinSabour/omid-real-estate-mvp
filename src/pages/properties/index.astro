---
import Layout from '../../layouts/Layout.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import propertiesData from '../../data/properties.json';
import type { Property } from '../../types/property';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const properties = propertiesData as Property[];
---

<Layout
  title="لیست املاک و مستغلات گلستان اهواز"
  description="جستجو و خرید و فروش جدیدترین آپارتمان‌ها، منازل ویلایی و واحدهای اداری و تجاری در محله گلستان اهواز با قیمت کارشناسی و مشاوره املاک امید."
>
  <!-- هدر صفحه آرشیو -->
  <section class="bg-primary-900 text-white py-12 border-b-2 border-accent-500/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-xs text-slate-300 mb-4 flex items-center gap-2">
        <a href={`${baseUrl}/`} class="hover:text-accent-400">خانه</a>
        <span>/</span>
        <span class="text-accent-400 font-bold">املاک گلستان</span>
      </nav>
      <h1 class="text-2xl sm:text-4xl font-black text-white mb-2">
        املاک و مستغلات <span class="text-accent-400">گلستان اهواز</span>
      </h1>
      <p class="text-sm text-slate-300">
        مشاهده تمام فایل‌های مسکونی، ویلایی و تجاری دارای مدارک رسمی و کارشناسی‌شده
      </p>
    </div>
  </section>

  <!-- بخش اصلی فیلتر و لیست -->
  <section class="py-12 bg-slate-50 min-h-[600px]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- نوار فیلتر و مرتب‌سازی -->
      <div class="bg-white p-4 sm:p-6 rounded-2xl shadow-sm border border-slate-200 mb-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <!-- فیلتر نوع ملک -->
          <div>
            <label for="filterType" class="block text-xs font-bold text-slate-700 mb-1">نوع ملک:</label>
            <select id="filterType" class="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 focus:border-accent-500 focus:ring-1 focus:ring-accent-400 bg-white">
              <option value="all">همه موارد</option>
              <option value="apartment">آپارتمان و پنت‌هاوس</option>
              <option value="villa">منزل ویلایی</option>
              <option value="commercial">تجاری / اداری</option>
            </select>
          </div>

          <!-- فیلتر وضعیت -->
          <div>
            <label for="filterStatus" class="block text-xs font-bold text-slate-700 mb-1">وضعیت معامله:</label>
            <select id="filterStatus" class="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 focus:border-accent-500 focus:ring-1 focus:ring-accent-400 bg-white">
              <option value="all">همه فایل‌ها</option>
              <option value="available" selected>فقط فایل‌های موجود</option>
              <option value="negotiating">در حال مذاکره</option>
              <option value="sold">فروخته شده</option>
            </select>
          </div>

          <!-- مرتب‌سازی -->
          <div>
            <label for="sortBy" class="block text-xs font-bold text-slate-700 mb-1">مرتب‌سازی بر اساس:</label>
            <select id="sortBy" class="w-full px-3 py-2 text-xs rounded-xl border border-slate-300 focus:border-accent-500 focus:ring-1 focus:ring-accent-400 bg-white">
              <option value="newest">جدیدترین فایل‌ها</option>
              <option value="price_asc">ارزان‌ترین به گران‌ترین</option>
              <option value="price_desc">گران‌ترین به ارزان‌ترین</option>
              <option value="area_desc">بزرگ‌ترین متراژ</option>
            </select>
          </div>

          <!-- دکمه بازنشانی فیلتر -->
          <div class="flex items-end">
            <button
              id="resetFiltersBtn"
              class="w-full py-2.5 px-4 text-xs font-bold rounded-xl border border-slate-300 hover:bg-slate-100 text-slate-700 transition-colors"
            >
              پاک کردن فیلترها
            </button>
          </div>
        </div>

        <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
          <span>تعداد نتایج یافت‌شده: <strong id="resultCount" class="text-primary-900 font-bold">{properties.length}</strong> ملک</span>
          <span class="text-slate-400">به‌روزرسانی خودکار نتایج</span>
        </div>
      </div>

      <!-- شبکه کارت‌های املاک -->
      <div id="propertiesGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {properties.map((prop) => (
          <div
            class="property-item"
            data-type={prop.propertyType}
            data-status={prop.status}
            data-price={prop.priceToman}
            data-area={prop.areaSqm}
            data-date={prop.createdAt}
          >
            <PropertyCard property={prop} baseUrl={baseUrl} />
          </div>
        ))}
      </div>

      <div id="noResultsMsg" class="hidden text-center py-16 bg-white rounded-2xl border border-slate-200">
        <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center">
          <svg class="w-6 h-6 shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
          </svg>
        </div>
        <h3 class="text-base font-bold text-slate-800 mb-1">ملکی با مشخصات انتخابی یافت نشد</h3>
        <p class="text-xs text-slate-500 mb-4">می‌توانید فیلترها را تغییر دهید یا مستقیماً با کارشناسان ما تماس بگیرید.</p>
        <a href={`${baseUrl}/#consultation`} class="inline-flex text-xs font-bold bg-accent-500 text-primary-900 px-4 py-2 rounded-xl">
          ثبت تقاضای سفارشی ملک
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  function applyFilters() {
    const filterType = (document.getElementById('filterType') as HTMLSelectElement)?.value || 'all';
    const filterStatus = (document.getElementById('filterStatus') as HTMLSelectElement)?.value || 'all';
    const sortBy = (document.getElementById('sortBy') as HTMLSelectElement)?.value || 'newest';

    const items = Array.from(document.querySelectorAll('.property-item')) as HTMLElement[];
    let visibleCount = 0;

    items.forEach((item) => {
      const type = item.getAttribute('data-type');
      const status = item.getAttribute('data-status');

      const matchesType = filterType === 'all' || type === filterType;
      const matchesStatus = filterStatus === 'all' || status === filterStatus;

      if (matchesType && matchesStatus) {
        item.style.display = '';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    // مرتب‌سازی آیتم‌های نمایان
    const grid = document.getElementById('propertiesGrid');
    if (grid) {
      items.sort((a, b) => {
        const priceA = parseFloat(a.getAttribute('data-price') || '0');
        const priceB = parseFloat(b.getAttribute('data-price') || '0');
        const areaA = parseFloat(a.getAttribute('data-area') || '0');
        const areaB = parseFloat(b.getAttribute('data-area') || '0');
        const dateA = new Date(a.getAttribute('data-date') || 0).getTime();
        const dateB = new Date(b.getAttribute('data-date') || 0).getTime();

        if (sortBy === 'price_asc') return priceA - priceB;
        if (sortBy === 'price_desc') return priceB - priceA;
        if (sortBy === 'area_desc') return areaB - areaA;
        return dateB - dateA;
      });

      items.forEach(item => grid.appendChild(item));
    }

    const countElem = document.getElementById('resultCount');
    if (countElem) countElem.innerText = String(visibleCount);

    const noResults = document.getElementById('noResultsMsg');
    if (noResults) {
      noResults.classList.toggle('hidden', visibleCount > 0);
    }
  }

  document.getElementById('filterType')?.addEventListener('change', applyFilters);
  document.getElementById('filterStatus')?.addEventListener('change', applyFilters);
  document.getElementById('sortBy')?.addEventListener('change', applyFilters);

  document.getElementById('resetFiltersBtn')?.addEventListener('click', () => {
    const type = document.getElementById('filterType') as HTMLSelectElement | null;
    const status = document.getElementById('filterStatus') as HTMLSelectElement | null;
    const sort = document.getElementById('sortBy') as HTMLSelectElement | null;
    if (type) type.value = 'all';
    if (status) status.value = 'all';
    if (sort) sort.value = 'newest';
    applyFilters();
  });

  // اجرای فیلتر اولیه
  applyFilters();
</script>
