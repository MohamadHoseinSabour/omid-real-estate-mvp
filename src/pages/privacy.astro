---
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="حریم خصوصی و امنیت اطلاعات | املاک امید"
  description="سیاست‌نامه حفظ حریم خصوصی، محرمانگی اطلاعات خریداران، فروشندگان و اسناد ملکی در آژانس املاک امید اهواز."
>
  <section class="bg-primary-900 text-white py-12 border-b-2 border-accent-500/20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-2xl sm:text-4xl font-black mb-2">سیاست حریم خصوصی</h1>
      <p class="text-xs sm:text-sm text-slate-300">اصول حفاظت از داده‌های شخصی و اسناد ملکی مشتریان</p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose text-slate-700 leading-loose text-sm space-y-6">
      <h2 class="text-lg font-bold text-primary-900">۱. تعهد به محرمانگی اطلاعات</h2>
      <p>
        آژانس املاک امید متعهد است که کلیه اطلاعات ثبت‌شده توسط کاربران گرامی اعم از نام، شماره تماس، حدود قیمت ملک، آدرس دقیق املاک و نسخه‌های اسناد مالکیتی را با بالاترین استانداردهای امنیتی نگهداری نموده و از هرگونه واگذاری، افشا یا استفاده غیرمجاز آن جلوگیری نماید.
      </p>

      <h2 class="text-lg font-bold text-primary-900">۲. نحوه استفاده از اطلاعات تماس</h2>
      <p>
        شماره‌های همراه و مشخصات ثبت‌شده در فرم‌های مشاوره صرفاً جهت هماهنگی جلسه، کارشناسی ملک یا ارائه فایل‌های مشابه توسط مشاورین رسمی املاک امید مورد استفاده قرار می‌گیرد و به هیچ عنوان برای اهداف تبلیغاتی شرکت‌های ثالث یا ارسال پیامک‌های انبوه استفاده نخواهد شد.
      </p>

      <h2 class="text-lg font-bold text-primary-900">۳. موقعیت مکانی املاک</h2>
      <p>
        به منظور رعایت حریم خصوصی و امنیت ساکنین، نشانی دقیق و پلاک ملک‌ها تا زمان احراز هویت اولیه متقاضی و هماهنگی جلسه بازدید حضوری به صورت عمومی در وبسایت منتشر نمی‌گردد و صرفاً محدوده محله و نام خیابان قید می‌شود.
      </p>
    </div>
  </section>
</Layout>
