---
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="صفحه مورد نظر یافت نشد (خطای ۴۰۴)">
  <section class="py-24 bg-slate-50 min-h-[600px] flex items-center justify-center">
    <div class="max-w-md mx-auto px-4 text-center">
      <div class="text-7xl font-black text-accent-500 font-mono mb-4">۴۰۴</div>
      <h1 class="text-2xl font-black text-primary-900 mb-3">
        صفحه مورد نظر یافت نشد
      </h1>
      <p class="text-sm text-slate-500 mb-8 leading-relaxed">
        ممکن است آدرس مورد نظر تغییر کرده باشد یا ملک مربوطه از لیست فایل‌های فعال خارج شده باشد.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href={`${baseUrl}/`}
          class="w-full sm:w-auto px-6 py-3 rounded-xl bg-primary-700 hover:bg-primary-800 text-white font-bold text-sm transition-colors"
        >
          بازگشت به صفحه اصلی
        </a>
        <a
          href={`${baseUrl}/properties/`}
          class="w-full sm:w-auto px-6 py-3 rounded-xl border border-slate-300 hover:bg-slate-100 text-slate-700 font-bold text-sm transition-colors"
        >
          مشاهده لیست املاک
        </a>
      </div>
    </div>
  </section>
</Layout>
