---
import Layout from '../layouts/Layout.astro';
import PropertyCard from '../components/PropertyCard.astro';
import CommissionCalculator from '../components/CommissionCalculator.astro';
import MortgageCalculator from '../components/MortgageCalculator.astro';
import ConsultationForm from '../components/ConsultationForm.astro';
import propertiesData from '../data/properties.json';
import blogData from '../data/blog.json';
import agencyData from '../data/agency.json';
import type { Property } from '../types/property';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const properties = propertiesData as Property[];
const featuredProperties = properties.slice(0, 3);
---

<Layout title="صفحه اصلی | تخصصی‌ترین معاملات املاک گلستان اهواز">
  <!-- ۱. بخش هیرو (Hero Section) -->
  <section class="relative bg-gradient-to-b from-primary-900 via-primary-800 to-primary-900 text-white overflow-hidden py-20 lg:py-28 border-b-2 border-accent-500/30">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#cda34f_1px,transparent_1px)] [background-size:24px_24px]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-accent-500/10 border border-accent-500/30 text-accent-400 text-xs sm:text-sm font-bold mb-6">
        <span class="w-2 h-2 rounded-full bg-accent-400 animate-ping"></span>
        تخصصی‌ترین مرجع خرید، فروش و رهن در محله گلستان اهواز
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight max-w-4xl mx-auto mb-6">
        معاملات هوشمند و مطمئن ملک در <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-400 via-accent-300 to-accent-500">گلستان اهواز</span>
      </h1>

      <p class="text-base sm:text-xl text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
        مشاوره تخصصی و حقوقی در تمامی مراحل معامله با همراهی بیش از ۸ کارشناس زبده و مورد اعتماد در منطقه گلستان، بوستان و سعدی.
      </p>

      <!-- دکمه‌های دوگانه هیرو با رفتار تعاملی -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto">
        <button
          type="button"
          data-intent="sell"
          class="hero-intent-btn w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl bg-gradient-to-r from-accent-400 to-accent-600 hover:from-accent-500 hover:to-accent-700 text-primary-900 font-extrabold text-base shadow-lg shadow-accent-500/30 hover:shadow-accent-500/50 transition-all transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-accent-400"
        >
          🏷️ می‌خواهم بفروشم
        </button>
        <button
          type="button"
          data-intent="buy"
          class="hero-intent-btn w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl bg-primary-700/80 hover:bg-primary-700 text-white border-2 border-accent-400/60 hover:border-accent-400 font-extrabold text-base shadow-md transition-all transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-accent-400"
        >
          🔍 می‌خواهم بخرم
        </button>
      </div>

      <!-- نوار آمار کلیدی -->
      <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto pt-10 border-t border-slate-700/60">
        <div>
          <div class="text-2xl sm:text-3xl font-black text-accent-400 font-mono">+{agencyData.stats.yearsExperience}</div>
          <div class="text-xs text-slate-300 mt-1">سال تجربه در گلستان</div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-black text-accent-400 font-mono">+{agencyData.stats.successfulDeals}</div>
          <div class="text-xs text-slate-300 mt-1">معامله موفق و رسمی</div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-black text-accent-400 font-mono">+{agencyData.stats.activeAdvisors}</div>
          <div class="text-xs text-slate-300 mt-1">مشاور فعال و متخصص</div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-black text-accent-400 font-mono">٪{agencyData.stats.customerSatisfactionPercent}</div>
          <div class="text-xs text-slate-300 mt-1">رضایت مشتریان</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ۲. فایل‌های برگزیده املاک گلستان -->
  <section class="py-16 sm:py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs font-bold text-accent-600 bg-accent-100 px-3 py-1 rounded-full">املاک برگزیده</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-primary-900 mt-2">تازه‌ترین فایل‌های مسکونی محله گلستان</h2>
          <p class="text-sm text-slate-500 mt-1">بررسی شده توسط کارشناسان حقوقی و ارزیابی قیمت روز منطقه</p>
        </div>
        <a
          href={`${baseUrl}/properties/`}
          class="inline-flex items-center gap-1 text-sm font-bold text-primary-700 hover:text-accent-600 transition-colors"
        >
          مشاهده تمام فایل‌های موجود
          <span>←</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredProperties.map((prop) => (
          <PropertyCard property={prop} baseUrl={baseUrl} />
        ))}
      </div>
    </div>
  </section>

  <!-- ۳. چرا املاک امید؟ -->
  <section class="py-16 bg-white border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-primary-900">چرا اهالی گلستان به املاک امید اعتماد دارند؟</h2>
        <p class="text-sm text-slate-500 mt-2">اصول کاری ما بر پایه شفافیت مطلق، امنیت اسناد و منافع دوطرفه خریدار و فروشنده است.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200/80">
          <div class="w-12 h-12 rounded-xl bg-accent-100 text-accent-600 flex items-center justify-center text-2xl mb-4 font-bold">
            ⚖️
          </div>
          <h3 class="text-lg font-bold text-primary-900 mb-2">استعلام و نظارت کامل حقوقی</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            بررسی دقیق وضعیت سند ثبتی، استعلام شهرداری، دارایی و اوقاف قبل از هرگونه تبادل وجه یا امضای مبایعه‌نامه.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200/80">
          <div class="w-12 h-12 rounded-xl bg-primary-100 text-primary-700 flex items-center justify-center text-2xl mb-4 font-bold">
            🤝
          </div>
          <h3 class="text-lg font-bold text-primary-900 mb-2">تعرفه کمیسیون عادلانه و شفاف</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            محاسبه حق‌الزحمه طبق نرخنامه مصوب اتحادیه املاک خوزستان بدون مبالغ مخفی و با ارائه فاکتور رسمی قانونی.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200/80">
          <div class="w-12 h-12 rounded-xl bg-accent-100 text-accent-600 flex items-center justify-center text-2xl mb-4 font-bold">
            📍
          </div>
          <h3 class="text-lg font-bold text-primary-900 mb-2">تسلط مویرگی بر بازار گلستان</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            بیش از ۸ مشاور بومی با شناخت دقیق متری به متری خیابان‌های فروردین، اردیبهشت، بوستان و چشم‌انداز آینده منطقه.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ۴. بخش ماشین‌حساب‌های هوشمند آنلاین -->
  <section id="calculators" class="py-16 sm:py-20 bg-slate-100/70 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold text-accent-600 bg-accent-100 px-3 py-1 rounded-full">ابزارهای محاسباتی رایگان</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-primary-900 mt-2">ماشین‌حساب‌های هوشمند مسکن</h2>
        <p class="text-sm text-slate-500 mt-1">محاسبه آنلاین کارمزد معامله و اقساط ماهانه وام مسکن بدون نیاز به مراجعه حضوری</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        <CommissionCalculator />
        <MortgageCalculator />
      </div>
    </div>
  </section>

  <!-- ۵. فرم مشاوره و لید (مقصد اسکرول هیرو) -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ConsultationForm baseUrl={baseUrl} defaultIntent="buy" source="homepage_hero" />
    </div>
  </section>

  <!-- ۶. وبلاگ و آخرین مقالات -->
  <section class="py-16 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs font-bold text-accent-600 bg-accent-100 px-3 py-1 rounded-full">آموزش و تحلیل</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-primary-900 mt-2">آخرین مقالات و راهنمای بازار مسکن</h2>
        </div>
        <a
          href={`${baseUrl}/blog/`}
          class="inline-flex items-center gap-1 text-sm font-bold text-primary-700 hover:text-accent-600 transition-colors"
        >
          مشاهده تمام مقالات
          <span>←</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {blogData.map((post) => (
          <article class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-md transition-shadow flex flex-col">
            <div class="aspect-video overflow-hidden">
              <img src={post.image} alt={post.title} loading="lazy" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
            </div>
            <div class="p-5 flex flex-col flex-grow">
              <div class="flex items-center justify-between text-xs text-slate-400 mb-2">
                <span>{post.category}</span>
                <span>{post.date}</span>
              </div>
              <h3 class="text-base font-bold text-slate-900 hover:text-primary-700 mb-2 line-clamp-2">
                <a href={`${baseUrl}/blog/${post.slug}/`}>{post.title}</a>
              </h3>
              <p class="text-xs text-slate-500 line-clamp-3 mb-4 leading-relaxed">{post.excerpt}</p>
              <div class="mt-auto pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
                <span>نویسنده: {post.author}</span>
                <span class="text-primary-700 font-bold hover:underline">مطالعه کامل ←</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  // هماهنگی اسکرول و انتخاب رادیوباتن فرم مشاوره از دکمه‌های هیرو
  const buttons = document.querySelectorAll('.hero-intent-btn');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const intent = btn.getAttribute('data-intent');
      const radio = document.querySelector(`input[name="intent"][value="${intent}"]`) as HTMLInputElement | null;
      if (radio) {
        radio.checked = true;
      }
      const target = document.getElementById('consultation');
      if (target) {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        target.scrollIntoView({
          behavior: prefersReducedMotion ? 'auto' : 'smooth',
          block: 'start',
        });
      }
    });
  });
</script>
