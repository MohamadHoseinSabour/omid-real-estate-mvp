---
import Layout from '../layouts/Layout.astro';
import PropertyCard from '../components/PropertyCard.astro';
import CommissionCalculator from '../components/CommissionCalculator.astro';
import MortgageCalculator from '../components/MortgageCalculator.astro';
import ConsultationForm from '../components/ConsultationForm.astro';
import HeroSection from '../components/HeroSection.astro';
import propertiesData from '../data/properties.json';
import blogData from '../data/blog.json';
import SchemaMarkup from '../components/SchemaMarkup.astro';
import type { Property } from '../types/property';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const properties = propertiesData as Property[];
const featuredProperties = properties.slice(0, 3);
---

<Layout title="صفحه اصلی | تخصصی‌ترین معاملات املاک گلستان اهواز">
  <SchemaMarkup type="agency" />

  <!-- ۱. بخش هیرو (Hero Section) با اسلایدر سه‌بعدی استوانه‌ای Tilted Grid -->
  <HeroSection />

  <!-- ۲. فایل‌های برگزیده املاک گلستان -->
  <section class="py-16 sm:py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs font-bold text-accent-600 bg-accent-100 px-3 py-1 rounded-full">املاک برگزیده</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-primary-900 mt-2">تازه‌ترین فایل‌های مسکونی محله گلستان</h2>
          <p class="text-sm text-slate-500 mt-1">بررسی شده توسط کارشناسان حقوقی و ارزیابی قیمت روز منطقه</p>
        </div>
        <a
          href={`${baseUrl}/properties/`}
          class="inline-flex items-center gap-1 text-sm font-bold text-primary-700 hover:text-accent-600 transition-colors"
        >
          مشاهده تمام فایل‌های موجود
          <span>←</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredProperties.map((prop) => (
          <PropertyCard property={prop} baseUrl={baseUrl} />
        ))}
      </div>
    </div>
  </section>

  <!-- ۳. چرا املاک امید؟ -->
  <section class="py-16 bg-white border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-primary-900">چرا اهالی گلستان به املاک امید اعتماد دارند؟</h2>
        <p class="text-sm text-slate-500 mt-2">اصول کاری ما بر پایه شفافیت مطلق، امنیت اسناد و منافع دوطرفه خریدار و فروشنده است.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200/80">
          <div class="w-12 h-12 rounded-xl bg-accent-100 text-accent-600 flex items-center justify-center text-2xl mb-4 font-bold">
            ⚖️
          </div>
          <h3 class="text-lg font-bold text-primary-900 mb-2">استعلام و نظارت کامل حقوقی</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            بررسی دقیق وضعیت سند ثبتی، استعلام شهرداری، دارایی و اوقاف قبل از هرگونه تبادل وجه یا امضای مبایعه‌نامه.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200/80">
          <div class="w-12 h-12 rounded-xl bg-primary-100 text-primary-700 flex items-center justify-center text-2xl mb-4 font-bold">
            🤝
          </div>
          <h3 class="text-lg font-bold text-primary-900 mb-2">تعرفه کمیسیون عادلانه و شفاف</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            محاسبه حق‌الزحمه طبق نرخنامه مصوب اتحادیه املاک خوزستان بدون مبالغ مخفی و با ارائه فاکتور رسمی قانونی.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200/80">
          <div class="w-12 h-12 rounded-xl bg-accent-100 text-accent-600 flex items-center justify-center text-2xl mb-4 font-bold">
            📍
          </div>
          <h3 class="text-lg font-bold text-primary-900 mb-2">تسلط مویرگی بر بازار گلستان</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            بیش از ۸ مشاور بومی با شناخت دقیق متری به متری خیابان‌های فروردین، اردیبهشت، بوستان و چشم‌انداز آینده منطقه.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ۴. بخش ماشین‌حساب‌های هوشمند آنلاین -->
  <section id="calculators" class="py-16 sm:py-20 bg-slate-100/70 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold text-accent-600 bg-accent-100 px-3 py-1 rounded-full">ابزارهای محاسباتی رایگان</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-primary-900 mt-2">ماشین‌حساب‌های هوشمند مسکن</h2>
        <p class="text-sm text-slate-500 mt-1">محاسبه آنلاین کارمزد معامله و اقساط ماهانه وام مسکن بدون نیاز به مراجعه حضوری</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        <CommissionCalculator />
        <MortgageCalculator />
      </div>
    </div>
  </section>

  <!-- ۵. فرم مشاوره و لید (مقصد اسکرول هیرو) -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ConsultationForm baseUrl={baseUrl} defaultIntent="buy" source="homepage_hero" />
    </div>
  </section>

  <!-- ۶. وبلاگ و آخرین مقالات -->
  <section class="py-16 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs font-bold text-accent-600 bg-accent-100 px-3 py-1 rounded-full">آموزش و تحلیل</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-primary-900 mt-2">آخرین مقالات و راهنمای بازار مسکن</h2>
        </div>
        <a
          href={`${baseUrl}/blog/`}
          class="inline-flex items-center gap-1 text-sm font-bold text-primary-700 hover:text-accent-600 transition-colors"
        >
          مشاهده تمام مقالات
          <span>←</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {blogData.map((post) => (
          <article class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-md transition-shadow flex flex-col">
            <div class="aspect-video overflow-hidden">
              <img src={post.image} alt={post.title} loading="lazy" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
            </div>
            <div class="p-5 flex flex-col flex-grow">
              <div class="flex items-center justify-between text-xs text-slate-400 mb-2">
                <span>{post.category}</span>
                <span>{post.date}</span>
              </div>
              <h3 class="text-base font-bold text-slate-900 hover:text-primary-700 mb-2 line-clamp-2">
                <a href={`${baseUrl}/blog/${post.slug}/`}>{post.title}</a>
              </h3>
              <p class="text-xs text-slate-500 line-clamp-3 mb-4 leading-relaxed">{post.excerpt}</p>
              <div class="mt-auto pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
                <span>نویسنده: {post.author}</span>
                <span class="text-primary-700 font-bold hover:underline">مطالعه کامل ←</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  // هماهنگی اسکرول و انتخاب رادیوباتن فرم مشاوره از دکمه‌های هیرو
  function handleHeroIntent(intent: string | null) {
    if (!intent) return;
    const radio = document.querySelector(`input[name="intent"][value="${intent}"]`) as HTMLInputElement | null;
    if (radio) {
      radio.checked = true;
    }
    const target = document.getElementById('consultation');
    if (target) {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      target.scrollIntoView({
        behavior: prefersReducedMotion ? 'auto' : 'smooth',
        block: 'start',
      });
    }
  }

  // شنود از طریق رویداد عمومی داکیومنت جهت تضمین کارکرد در تمامی شرایط هیدریشن
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element | null)?.closest('.hero-intent-btn');
    if (btn) {
      const intent = btn.getAttribute('data-intent');
      handleHeroIntent(intent);
    }
  });
</script>
