---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<DashboardLayout title="پیشخوان مدیریت" activeNav="overview">
  <div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-black text-slate-900 flex items-center gap-2">
        <span>پیشخوان آمار و عملکرد املاک امید</span>
      </h1>
      <p class="text-xs text-slate-500 mt-1">خلاصه پرونده‌های ملکی، معاملات جاری، فایلینگ مشارکتی و امور مالی در گلستان اهواز</p>
    </div>
    <div class="flex items-center gap-2">
      <span id="overviewDateBadge" class="text-xs bg-white border border-slate-200 px-3 py-1.5 rounded-xl font-mono text-slate-600 shadow-sm whitespace-nowrap shrink-0">
        ۱۴۰۳/۰۷/۱۸
      </span>
    </div>
  </div>

  <!-- بنر هشدار تسویه‌های معوق برای مدیرکل و منشی -->
  <div id="pendingPayoutBanner" class="hidden mb-8 p-4 rounded-2xl bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 font-bold text-xs shadow-md flex flex-wrap sm:flex-nowrap items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-slate-950 text-amber-400 flex items-center justify-center shrink-0">
        <svg class="w-5 h-5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
        </svg>
      </div>
      <div>
        <strong class="text-sm block">توجه مدیریت: تسویه کارمزد معوق در انتظار اقدام</strong>
        <span class="font-normal text-[11px] text-slate-950/90" id="pendingPayoutBannerText"></span>
      </div>
    </div>
    <a
      href={`${baseUrl}/dashboard/sales/`}
      class="bg-slate-950 hover:bg-slate-900 text-white font-bold text-xs py-2 px-4 rounded-xl shadow transition-colors whitespace-nowrap shrink-0 ms-auto sm:ms-0"
    >
      بررسی و واریز آنی ↗
    </a>
  </div>

  <!-- کارت‌های آمار کلیدی ۴گانه پویا -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-200">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs text-slate-500 font-bold whitespace-nowrap" id="card1Label">فایل‌های فعال</span>
        <div class="w-9 h-9 rounded-xl bg-primary-100 text-primary-700 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4zm3 1h2v2H7V5zm4 0h2v2h-2V5zm-4 4h2v2H7V9zm4 0h2v2h-2V9zm-4 4h2v2H7v-2zm4 0h2v2h-2v-2z" clip-rule="evenodd" />
          </svg>
        </div>
      </div>
      <div class="text-2xl font-black text-slate-900 font-mono" id="card1Val">۰ ملک</div>
      <div class="text-[11px] text-emerald-600 font-semibold mt-1">آماده معامله در گلستان</div>
    </div>

    <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-200">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs text-slate-500 font-bold whitespace-nowrap">قراردادهای ثبت‌شده</span>
        <div class="w-9 h-9 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v1h8v-1zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 16v-1a4 4 0 00-1.78-3.32 4.004 4.004 0 011.78 4.32zM4 16v-1c0-.73.2-1.41.55-2A4.004 4.004 0 002 16h2z" />
          </svg>
        </div>
      </div>
      <div class="text-2xl font-black text-slate-900 font-mono" id="card2Val">۰ معامله</div>
      <div class="text-[11px] text-blue-600 font-semibold mt-1">شامل مستقیم و مشارکتی</div>
    </div>

    <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-200">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs text-slate-500 font-bold whitespace-nowrap" id="card3Label">موجودی کیف پول</span>
        <div class="w-9 h-9 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z" />
            <path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z" clip-rule="evenodd" />
          </svg>
        </div>
      </div>
      <div class="text-xl font-black text-amber-600 font-mono" id="card3Val">۰ تومان</div>
      <div class="text-[11px] text-slate-400 mt-1">محاسبه بر مبنای نرخ ۳۰٪ پورسانت</div>
    </div>

    <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-200">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs text-slate-500 font-bold whitespace-nowrap">فایلینگ اشتراکی همکاران</span>
        <div class="w-9 h-9 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM4.332 8.027a6.012 6.012 0 011.912-2.706C6.512 5.73 6.974 6 7.5 6A1.5 1.5 0 019 7.5V8a2 2 0 004 0 2 2 0 011.523-1.943A5.977 5.977 0 0116 10c0 .34-.028.675-.083 1H15a2 2 0 00-2 2v.183A5.992 5.992 0 0110 16a5.973 5.973 0 01-4-1.528v-1.722a2 2 0 00-1.668-1.975z" clip-rule="evenodd" />
          </svg>
        </div>
      </div>
      <div class="text-2xl font-black text-slate-900 font-mono" id="card4Val">۰ فایل</div>
      <div class="text-[11px] text-emerald-600 font-semibold mt-1">فرصت‌های فروش مشارکتی</div>
    </div>
  </div>

  <!-- بخش اصلی: پرونده‌های اخیر و عملیات سریع -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2 bg-white rounded-3xl p-6 shadow-sm border border-slate-200">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-base font-black text-slate-900" id="recentPropsTitle">آخرین وضعیت پرونده‌های ملکی</h2>
          <p class="text-[11px] text-slate-400">به‌روزرسانی همگام با سیستم RLS</p>
        </div>
        <a href={`${baseUrl}/dashboard/properties/`} class="text-xs text-primary-700 font-bold hover:underline whitespace-nowrap shrink-0">مشاهده همه ↗</a>
      </div>

      <div class="divide-y divide-slate-100 text-xs" id="overviewPropsList">
        <!-- داینامیک -->
      </div>
    </div>

    <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200 flex flex-col justify-between">
      <div>
        <h2 class="text-base font-black text-slate-900 mb-1">عملیات سریع و میانبرها</h2>
        <p class="text-[11px] text-slate-400 mb-5">دسترسی سریع به بخش‌های اصلی پنل</p>

        <div class="space-y-3">
          <a
            href={`${baseUrl}/dashboard/properties/`}
            class="w-full flex items-center justify-between p-3.5 rounded-2xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-xs font-bold text-slate-800 transition-colors"
          >
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-primary-700 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4zm3 1h2v2H7V5zm4 0h2v2h-2V5zm-4 4h2v2H7V9zm4 0h2v2h-2V9zm-4 4h2v2H7v-2zm4 0h2v2h-2v-2z" clip-rule="evenodd" />
              </svg>
              <span class="whitespace-nowrap">ثبت و مدیریت فایل‌های ملکی</span>
            </div>
            <span class="text-slate-400 shrink-0">←</span>
          </a>

          <a
            href={`${baseUrl}/dashboard/co-filing/`}
            class="w-full flex items-center justify-between p-3.5 rounded-2xl bg-emerald-50/70 hover:bg-emerald-100/80 border border-emerald-200 text-xs font-bold text-emerald-900 transition-colors"
          >
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-emerald-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v1h8v-1zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 16v-1a4 4 0 00-1.78-3.32 4.004 4.004 0 011.78 4.32zM4 16v-1c0-.73.2-1.41.55-2A4.004 4.004 0 002 16h2z" />
              </svg>
              <span class="whitespace-nowrap">فایلینگ اشتراکی همکاران (MLS)</span>
            </div>
            <span class="text-emerald-500 shrink-0">←</span>
          </a>

          <a
            href={`${baseUrl}/dashboard/sales/`}
            class="w-full flex items-center justify-between p-3.5 rounded-2xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-xs font-bold text-slate-800 transition-colors"
          >
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-blue-700 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path d="M17.414 2.586a2 2 0 00-2.828 0L7 10.172V13h2.828l7.586-7.586a2 2 0 000-2.828z" />
                <path fill-rule="evenodd" d="M2 6a2 2 0 012-2h4a1 1 0 010 2H4v10h10v-4a1 1 0 112 0v4a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" clip-rule="evenodd" />
              </svg>
              <span class="whitespace-nowrap">قراردادها و تسویه فروش</span>
            </div>
            <span class="text-slate-400 shrink-0">←</span>
          </a>

          <a
            href={`${baseUrl}/dashboard/wallet/`}
            class="w-full flex items-center justify-between p-3.5 rounded-2xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-xs font-bold text-slate-800 transition-colors"
          >
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-amber-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z" />
                <path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z" clip-rule="evenodd" />
              </svg>
              <span class="whitespace-nowrap">کیف پول و حسابداری کارمزد</span>
            </div>
            <span class="text-slate-400 shrink-0">←</span>
          </a>

          <a
            href={`${baseUrl}/dashboard/leads/`}
            class="w-full flex items-center justify-between p-3.5 rounded-2xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-xs font-bold text-slate-800 transition-colors"
          >
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-purple-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z" />
              </svg>
              <span class="whitespace-nowrap">باشگاه مشتریان و تقاضاها</span>
            </div>
            <span class="text-slate-400 shrink-0">←</span>
          </a>
        </div>
      </div>

      <!-- باکس یادآوری امنیتی -->
      <div class="mt-6 p-4 rounded-2xl bg-slate-900 text-white text-[11px] leading-relaxed border border-slate-800" style="background-color: #0b1a2e;">
        <div class="text-accent-400 font-bold mb-1 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd" />
          </svg>
          <span>نظارت و انضباط مالی:</span>
        </div>
        <p class="text-slate-300">
          تمامی تغییرات کیف پول و تسویه‌ها به صورت غیرقابل تغییر در دفتر کل ثبت شده و دارای ردیابی کاربر است.
        </p>
      </div>
    </div>
  </div>
</DashboardLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    if (!window.OmidDashboard) return;

    const currentUser = window.OmidDashboard.getCurrentUser();
    const isStaff = currentUser.role === 'admin' || currentUser.role === 'secretary';

    document.getElementById('overviewDateBadge').innerText = window.OmidDashboard.getJalaliDate();

    const allProps = window.OmidDashboard.getProperties();
    const allSales = window.OmidDashboard.getSales();
    const pendingSales = allSales.filter((s) => s.payoutStatus === 'pending_approval');

    // بنر تسویه معوق
    if (isStaff && pendingSales.length > 0) {
      const banner = document.getElementById('pendingPayoutBanner');
      const text = document.getElementById('pendingPayoutBannerText');
      banner.classList.remove('hidden');
      text.innerText = `تعداد ${pendingSales.length} معامله جدید ثبت شده و در انتظار تایید واریز پورسانت به کیف پول مشاوران است.`;
    }

    // مقادیر کارت‌های آمار
    if (isStaff) {
      document.getElementById('card1Label').innerText = 'کل فایل‌های آژانس';
      document.getElementById('card1Val').innerText = `${allProps.length} ملک`;

      document.getElementById('card3Label').innerText = 'کل پورسانت‌های تسویه‌شده';
      const totalPaid = allSales
        .filter((s) => s.payoutStatus === 'paid')
        .reduce((sum, s) => sum + (s.listingAdvisorShareToman || 0) + (s.sellingAdvisorShareToman || 0), 0);
      document.getElementById('card3Val').innerText = window.OmidDashboard.formatToman(totalPaid);
    } else {
      const myProps = allProps.filter((p) => p.advisor.id === currentUser.id);
      document.getElementById('card1Label').innerText = 'فایل‌های اختصاصی من';
      document.getElementById('card1Val').innerText = `${myProps.length} ملک`;

      document.getElementById('card3Label').innerText = 'موجودی کیف پول من';
      const myBal = window.OmidDashboard.getAdvisorBalance(currentUser.id);
      document.getElementById('card3Val').innerText = window.OmidDashboard.formatToman(myBal);
    }

    document.getElementById('card2Val').innerText = `${allSales.length} معامله`;
    document.getElementById('card4Val').innerText = `${allProps.filter((p) => p.status === 'available').length} فرصت فعال`;

    // لیست پرونده‌های اخیر
    const propsList = document.getElementById('overviewPropsList');
    const displayProps = isStaff ? allProps.slice(0, 5) : allProps.filter((p) => p.advisor.id === currentUser.id).slice(0, 5);

    if (displayProps.length === 0) {
      propsList.innerHTML = '<div class="py-6 text-center text-slate-400">فایلی جهت نمایش وجود ندارد.</div>';
    } else {
      propsList.innerHTML = displayProps.map((p) => `
        <div class="py-3.5 flex items-center justify-between gap-4">
          <div>
            <strong class="block text-slate-900 text-sm mb-0.5">${p.title}</strong>
            <div class="text-slate-400 text-[11px] flex items-center gap-2">
              <span class="flex items-center gap-1">
                <svg class="w-3 h-3 text-accent-500 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                </svg>
                <span>${p.address}</span>
              </span>
              ${isStaff ? `<span class="bg-primary-50 text-primary-800 px-2 py-0.5 rounded font-bold">مشاور: ${p.advisor.name}</span>` : ''}
            </div>
          </div>
          <div class="text-end shrink-0">
            <span class="inline-block px-2.5 py-1 rounded-lg text-[11px] font-bold ${
              p.status === 'available'
                ? 'bg-emerald-100 text-emerald-800'
                : p.status === 'negotiating'
                ? 'bg-amber-100 text-amber-800'
                : 'bg-slate-200 text-slate-700'
            }">
              ${p.statusLabel}
            </span>
            <div class="font-mono text-slate-700 font-bold text-xs mt-1">
              ${window.OmidDashboard.formatToman(p.priceToman)}
            </div>
          </div>
        </div>
      `).join('');
    }
  });
</script>
