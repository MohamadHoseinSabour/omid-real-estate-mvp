---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!DOCTYPE html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ورود به پنل مدیریت | املاک امید</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link
      href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css"
      rel="stylesheet"
      type="text/css"
    />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-900 text-slate-100 font-vazir min-h-screen flex items-center justify-center p-4">
    <div class="max-w-md w-full bg-slate-800 rounded-3xl p-8 shadow-2xl border border-slate-700">
      <div class="text-center mb-8">
        <div class="w-14 h-14 rounded-2xl bg-amber-500 text-slate-900 font-black flex items-center justify-center text-2xl mx-auto mb-3 shadow-lg">
          ام
        </div>
        <h1 class="text-2xl font-black text-white">ورود پرسنل و مشاوران</h1>
        <p class="text-xs text-slate-400 mt-1">آژانس املاک امید — گلستان اهواز</p>
      </div>

      <!-- فرم ورود -->
      <form id="loginForm" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-300 mb-1">پست الکترونیک (ایمیل):</label>
          <input
            type="email"
            id="emailInput"
            value="karimi@omidrealestate.ir"
            required
            dir="ltr"
            class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm focus:border-amber-400 focus:outline-none"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-300 mb-1">رمز عبور:</label>
          <input
            type="password"
            id="passwordInput"
            value="••••••••••••"
            required
            dir="ltr"
            class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm focus:border-amber-400 focus:outline-none"
          />
        </div>

        <button
          type="submit"
          class="w-full bg-amber-500 hover:bg-amber-600 text-slate-900 font-black py-3.5 px-6 rounded-xl text-sm transition-colors shadow-lg"
        >
          ورود به داشبورد
        </button>
      </form>

      <!-- دکمه‌های ورود آزمایشی سریع ۳ نقش -->
      <div class="mt-8 pt-6 border-t border-slate-700/80">
        <div class="text-[11px] text-center text-slate-400 mb-3">ورود سریع آزمایشی با نقش‌های تعریف‌شده:</div>
        <div class="grid grid-cols-3 gap-2 text-xs">
          <button
            type="button"
            onclick="quickLogin('advisor')"
            class="py-2 px-1 rounded-lg bg-slate-700 hover:bg-slate-600 text-amber-300 text-center font-bold"
          >
            مشاور
          </button>
          <button
            type="button"
            onclick="quickLogin('secretary')"
            class="py-2 px-1 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 text-center font-bold"
          >
            منشی
          </button>
          <button
            type="button"
            onclick="quickLogin('admin')"
            class="py-2 px-1 rounded-lg bg-slate-700 hover:bg-slate-600 text-emerald-300 text-center font-bold"
          >
            مدیرکل
          </button>
        </div>
      </div>

      <div class="mt-6 text-center">
        <a href={`${baseUrl}/`} class="text-xs text-slate-400 hover:text-amber-400">
          ← بازگشت به وبسایت عمومی
        </a>
      </div>
    </div>

    <script is:inline>
      const baseUrl = '{baseUrl}';

      function quickLogin(role) {
        localStorage.setItem('omid_current_role', role);
        window.location.href = window.location.pathname.replace(/\/login\/?$/, '/');
      }

      document.getElementById('loginForm')?.addEventListener('submit', (e) => {
        e.preventDefault();
        localStorage.setItem('omid_current_role', 'advisor');
        window.location.href = window.location.pathname.replace(/\/login\/?$/, '/');
      });
    </script>
  </body>
</html>
