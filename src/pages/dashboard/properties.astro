---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<DashboardLayout title="مدیریت املاک و فایل‌ها" activeNav="properties">
  <!-- هدر صفحه و دکمه اقدام -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-black text-slate-900" id="pageTitleHeading">مدیریت املاک و فایل‌ها</h1>
        <span id="accessLevelBadge" class="text-xs px-2.5 py-0.5 rounded-full font-bold whitespace-nowrap shrink-0"></span>
      </div>
      <p class="text-xs text-slate-500 mt-1" id="pageDescription">
        مشاهده، ویرایش، حذف و کنترل پرونده‌های ملکی در محله گلستان اهواز
      </p>
    </div>
    <div class="flex items-center gap-3 shrink-0">
      <a
        href={`${baseUrl}/dashboard/co-filing/`}
        class="bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold text-xs py-2.5 px-4 rounded-xl transition-colors flex items-center gap-2 whitespace-nowrap shrink-0"
      >
        <svg class="w-4 h-4 text-slate-700 shrink-0" viewBox="0 0 20 20" fill="currentColor">
          <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v1h8v-1zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 16v-1a4 4 0 00-1.78-3.32 4.004 4.004 0 011.78 4.32zM4 16v-1c0-.73.2-1.41.55-2A4.004 4.004 0 002 16h2z" />
        </svg>
        <span>فایلینگ اشتراکی همکاران</span>
      </a>
      <button
        id="openNewPropBtn"
        class="bg-accent-500 hover:bg-accent-600 text-slate-950 font-black text-xs py-2.5 px-4 rounded-xl shadow-md transition-all flex items-center gap-2 whitespace-nowrap shrink-0"
      >
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
        </svg>
        <span>ثبت ملک جدید</span>
      </button>
    </div>
  </div>

  <div id="advisorAccessNotice" class="hidden mb-6 p-4 rounded-2xl bg-blue-50 border border-blue-200 text-xs text-blue-900 flex flex-wrap sm:flex-nowrap items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <svg class="w-5 h-5 text-blue-600 shrink-0" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
      </svg>
      <div>
        <strong class="font-bold">حالت نمایش مشاور:</strong>
        <span>شما در این صفحه فقط فایل‌های شخصی خودتان را مشاهده و مدیریت می‌کنید. برای فایل‌های سایر همکاران به بخش فایلینگ اشتراکی بروید.</span>
      </div>
    </div>
    <a href={`${baseUrl}/dashboard/co-filing/`} class="text-primary-700 font-bold hover:underline whitespace-nowrap shrink-0 ms-auto sm:ms-0">ورود به فایلینگ اشتراکی ↗</a>
  </div>

  <!-- نوار جستجو و فیلترهای پیشرفته -->
  <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 mb-6 flex flex-wrap items-center justify-between gap-4 text-xs">
    <div class="flex flex-wrap items-center gap-3 flex-grow max-w-2xl">
      <div class="relative flex-grow min-w-[200px]">
        <input
          type="text"
          id="propSearchInput"
          placeholder="جستجو در عنوان، آدرس یا کد ملک..."
          class="w-full ps-9 pe-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-1 focus:ring-accent-500 focus:outline-none"
        />
        <svg class="absolute start-3 top-2.5 w-4 h-4 text-slate-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
        </svg>
      </div>

      <div id="advisorFilterContainer" class="hidden">
        <select id="advisorFilterSelect" class="p-2 rounded-xl border border-slate-300 text-xs bg-slate-50 focus:outline-none">
          <option value="all">همه مشاوران (کل آژانس)</option>
          <option value="user-adv-101">مهندس رضا کریمی</option>
          <option value="user-adv-102">علیرضا احمدی</option>
          <option value="user-adv-103">سارا محمدی</option>
          <option value="user-adv-104">محمدرضا رضایی</option>
        </select>
      </div>

      <select id="statusFilterSelect" class="p-2 rounded-xl border border-slate-300 text-xs bg-slate-50 focus:outline-none">
        <option value="all">همه وضعیت‌ها</option>
        <option value="available">موجود</option>
        <option value="negotiating">در حال مذاکره</option>
        <option value="sold">فروخته شد</option>
      </select>

      <select id="typeFilterSelect" class="p-2 rounded-xl border border-slate-300 text-xs bg-slate-50 focus:outline-none">
        <option value="all">همه انواع ملک</option>
        <option value="apartment">آپارتمان</option>
        <option value="villa">ویلایی</option>
        <option value="commercial">تجاری / اداری</option>
      </select>
    </div>

    <div class="text-slate-500 font-bold" id="propertiesStatsCounter">
      در حال بارگذاری...
    </div>
  </div>

  <!-- جدول لیست املاک -->
  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-xs text-start" id="propertiesTable">
        <thead class="bg-slate-50 text-slate-600 font-bold border-b border-slate-200">
          <tr>
            <th class="p-3.5 text-start whitespace-nowrap">کد / عنوان ملک</th>
            <th class="p-3.5 text-start whitespace-nowrap">قیمت کل (تومان)</th>
            <th class="p-3.5 text-start whitespace-nowrap">متراژ و نوع</th>
            <th class="p-3.5 text-start whitespace-nowrap">مشاور مسئول (مالک فایل)</th>
            <th class="p-3.5 text-start whitespace-nowrap">وضعیت</th>
            <th class="p-3.5 text-center whitespace-nowrap">عملیات مدیریتی</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100" id="propertiesTableBody">
          <!-- با جاوااسکریپت داینامیک پر می‌شود -->
        </tbody>
      </table>
    </div>

    <div id="noPropsFound" class="hidden p-12 text-center text-slate-400 text-xs">
      هیچ ملکی با مشخصات انتخابی یافت نشد.
    </div>
  </div>

  <!-- مودال ثبت ملک جدید -->
  <div id="newPropModal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white w-full max-w-2xl rounded-3xl p-6 sm:p-8 shadow-2xl border border-slate-200 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-6">
        <h2 class="text-base font-black text-primary-950 border-s-4 border-accent-500 ps-2">فرم ثبت فایل و ملک جدید</h2>
        <button type="button" id="closeNewModalX" class="text-slate-400 hover:text-slate-700 text-lg">✕</button>
      </div>

      <form id="newPropertyForm" class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <div class="sm:col-span-2">
          <label class="block font-bold text-slate-700 mb-1">عنوان ملک *</label>
          <input type="text" id="newTitle" required placeholder="مثال: آپارتمان ۱۴۰ متری خیابان اردیبهشت" class="w-full p-2.5 rounded-xl border border-slate-300 text-xs" />
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">قیمت کل (تومان) *</label>
          <input type="number" id="newPrice" required placeholder="۳۵۰۰۰۰۰۰۰۰" class="w-full p-2.5 rounded-xl border border-slate-300 text-xs font-mono text-end" dir="ltr" />
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">متراژ مفید (متر مربع) *</label>
          <input type="number" id="newArea" required placeholder="۱۴۰" class="w-full p-2.5 rounded-xl border border-slate-300 text-xs text-center" />
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">نوع ملک</label>
          <select id="newType" class="w-full p-2.5 rounded-xl border border-slate-300 text-xs bg-white">
            <option value="apartment">آپارتمان</option>
            <option value="villa">ویلایی</option>
            <option value="commercial">تجاری / اداری</option>
          </select>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">تعداد خواب</label>
          <select id="newBedrooms" class="w-full p-2.5 rounded-xl border border-slate-300 text-xs bg-white">
            <option value="1">۱ خواب</option>
            <option value="2">۲ خواب</option>
            <option value="3" selected>۳ خواب</option>
            <option value="4">۴ خواب</option>
          </select>
        </div>

        <div class="sm:col-span-2">
          <label class="block font-bold text-slate-700 mb-1">آدرس در محله گلستان اهواز *</label>
          <input type="text" id="newAddress" required placeholder="اهواز، محله گلستان، خیابان..." class="w-full p-2.5 rounded-xl border border-slate-300 text-xs" />
        </div>

        <!-- فیلد انتخاب مشاور فقط برای سطوح مدیر/منشی -->
        <div id="newAdvisorRow" class="hidden sm:col-span-2">
          <label class="block font-bold text-slate-700 mb-1">مشاور مسئول پرونده (تخصیص فایل)</label>
          <select id="newAdvisorSelect" class="w-full p-2.5 rounded-xl border border-slate-300 text-xs bg-white">
            <option value="user-adv-101">مهندس رضا کریمی</option>
            <option value="user-adv-102">علیرضا احمدی</option>
            <option value="user-adv-103">سارا محمدی</option>
            <option value="user-adv-104">محمدرضا رضایی</option>
          </select>
        </div>

        <div class="sm:col-span-2 flex justify-end gap-3 pt-4 border-t border-slate-100">
          <button type="button" id="cancelNewPropBtn" class="px-5 py-2.5 border rounded-xl text-slate-600 font-bold hover:bg-slate-50">انصراف</button>
          <button type="submit" class="px-6 py-2.5 bg-primary-900 hover:bg-primary-800 text-white rounded-xl font-bold shadow-md">
            ذخیره و انتشار فایل
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- مودال ویرایش ملک (مخصوص سطوح بالاتر و مشاور برای فایل خودش) -->
  <div id="editPropModal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white w-full max-w-2xl rounded-3xl p-6 sm:p-8 shadow-2xl border border-slate-200 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-6">
        <div>
          <h2 class="text-base font-black text-primary-950 border-s-4 border-amber-500 ps-2">ویرایش مشخصات پرونده ملکی</h2>
          <span id="editPropIdBadge" class="text-[11px] font-mono text-slate-400 ms-3"></span>
        </div>
        <button type="button" id="closeEditModalX" class="text-slate-400 hover:text-slate-700 text-lg">✕</button>
      </div>

      <form id="editPropertyForm" class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <input type="hidden" id="editPropId" />

        <div class="sm:col-span-2">
          <label class="block font-bold text-slate-700 mb-1">عنوان ملک *</label>
          <input type="text" id="editTitle" required class="w-full p-2.5 rounded-xl border border-slate-300 text-xs font-bold" />
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">قیمت کل (تومان) *</label>
          <input type="number" id="editPrice" required class="w-full p-2.5 rounded-xl border border-slate-300 text-xs font-mono text-end font-bold" dir="ltr" />
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">متراژ مفید (متر مربع) *</label>
          <input type="number" id="editArea" required class="w-full p-2.5 rounded-xl border border-slate-300 text-xs text-center font-bold" />
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">وضعیت پرونده</label>
          <select id="editStatus" class="w-full p-2.5 rounded-xl border border-slate-300 text-xs bg-white font-bold">
            <option value="available">موجود (آماده فروش)</option>
            <option value="negotiating">در حال مذاکره / قرارداد</option>
            <option value="sold">فروخته شد (پایان معامله)</option>
          </select>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">تعداد اتاق خواب</label>
          <select id="editBedrooms" class="w-full p-2.5 rounded-xl border border-slate-300 text-xs bg-white">
            <option value="1">۱ خواب</option>
            <option value="2">۲ خواب</option>
            <option value="3">۳ خواب</option>
            <option value="4">۴ خواب</option>
          </select>
        </div>

        <div class="sm:col-span-2">
          <label class="block font-bold text-slate-700 mb-1">آدرس در محله گلستان اهواز *</label>
          <input type="text" id="editAddress" required class="w-full p-2.5 rounded-xl border border-slate-300 text-xs" />
        </div>

        <div class="sm:col-span-2" id="editAdvisorContainer">
          <label class="block font-bold text-slate-700 mb-1">مشاور مسئول (جابجایی مالکیت فایل)</label>
          <select id="editAdvisorSelect" class="w-full p-2.5 rounded-xl border border-slate-300 text-xs bg-white">
            <option value="user-adv-101">مهندس رضا کریمی</option>
            <option value="user-adv-102">علیرضا احمدی</option>
            <option value="user-adv-103">سارا محمدی</option>
            <option value="user-adv-104">محمدرضا رضایی</option>
          </select>
          <span class="text-[10px] text-slate-400 block mt-1">مدیر و منشی می‌توانند مشاور مسئول این فایل را تغییر دهند.</span>
        </div>

        <div class="sm:col-span-2 flex justify-end gap-3 pt-4 border-t border-slate-100">
          <button type="button" id="cancelEditPropBtn" class="px-5 py-2.5 border rounded-xl text-slate-600 font-bold hover:bg-slate-50">انصراف</button>
          <button type="submit" class="px-6 py-2.5 bg-amber-600 hover:bg-amber-700 text-white rounded-xl font-bold shadow-md">
            ثبت تغییرات و ویرایش
          </button>
        </div>
      </form>
    </div>
  </div>
</DashboardLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    if (!window.OmidDashboard) return;

    const currentUser = window.OmidDashboard.getCurrentUser();
    const isStaff = currentUser.role === 'admin' || currentUser.role === 'secretary';

    // تنظیم نشان سطح دسترسی
    const accessBadge = document.getElementById('accessLevelBadge');
    const advisorNotice = document.getElementById('advisorAccessNotice');
    const advisorFilterContainer = document.getElementById('advisorFilterContainer');
    const newAdvisorRow = document.getElementById('newAdvisorRow');
    const pageDescription = document.getElementById('pageDescription');

    if (isStaff) {
      accessBadge.innerText = currentUser.role === 'admin' ? 'دسترسی کامل مدیرکل (مدیریت، ویرایش و حذف همه فایل‌ها)' : 'دسترسی منشی دفتر (مشاهده و ویرایش کلیه فایل‌ها)';
      accessBadge.className = currentUser.role === 'admin' ? 'text-xs px-2.5 py-0.5 rounded-full font-bold bg-rose-100 text-rose-800 border border-rose-300' : 'text-xs px-2.5 py-0.5 rounded-full font-bold bg-blue-100 text-blue-800 border border-blue-300';
      advisorFilterContainer.classList.remove('hidden');
      newAdvisorRow.classList.remove('hidden');
      pageDescription.innerText = 'شما به عنوان سطح مدیریتی، تمام آگهی‌های ثبت‌شده توسط کلیه مشاوران را مشاهده می‌کنید و امکان ویرایش یا حذف پرونده‌ها را دارید.';
    } else {
      accessBadge.innerText = 'دسترسی مشاور (فایل‌های اختصاصی)';
      accessBadge.className = 'text-xs px-2.5 py-0.5 rounded-full font-bold bg-emerald-100 text-emerald-800 border border-emerald-300';
      advisorNotice.classList.remove('hidden');
    }

    // رندر جدول
    function renderProperties() {
      const allProps = window.OmidDashboard.getProperties();
      const searchQuery = (document.getElementById('propSearchInput')?.value || '').toLowerCase().trim();
      const advisorFilter = document.getElementById('advisorFilterSelect')?.value || 'all';
      const statusFilter = document.getElementById('statusFilterSelect')?.value || 'all';
      const typeFilter = document.getElementById('typeFilterSelect')?.value || 'all';

      // فیلتر اولیه بر اساس سطح دسترسی مشاور vs مدیر/منشی
      let filtered = allProps;
      if (!isStaff) {
        filtered = filtered.filter((p) => p.advisor.id === currentUser.id);
      } else {
        if (advisorFilter !== 'all') {
          filtered = filtered.filter((p) => p.advisor.id === advisorFilter);
        }
      }

      // فیلتر جستجو
      if (searchQuery) {
        filtered = filtered.filter((p) =>
          p.title.toLowerCase().includes(searchQuery) ||
          p.address.toLowerCase().includes(searchQuery) ||
          p.id.toLowerCase().includes(searchQuery) ||
          p.advisor.name.toLowerCase().includes(searchQuery)
        );
      }

      // فیلتر وضعیت
      if (statusFilter !== 'all') {
        filtered = filtered.filter((p) => p.status === statusFilter);
      }

      // فیلتر نوع
      if (typeFilter !== 'all') {
        filtered = filtered.filter((p) => p.propertyType === typeFilter);
      }

      const tbody = document.getElementById('propertiesTableBody');
      const counter = document.getElementById('propertiesStatsCounter');
      const noProps = document.getElementById('noPropsFound');

      if (counter) {
        counter.innerText = `نمایش ${filtered.length} از مجموع ${allProps.length} فایل`;
      }

      if (filtered.length === 0) {
        tbody.innerHTML = '';
        noProps.classList.remove('hidden');
        return;
      }

      noProps.classList.add('hidden');
      tbody.innerHTML = filtered.map((prop) => {
        const isMine = prop.advisor.id === currentUser.id;
        const canDelete = currentUser.role === 'admin';
        const canEdit = isStaff || isMine;

        return `
          <tr class="hover:bg-slate-50/80 transition-colors">
            <td class="p-3.5">
              <div class="font-bold text-slate-900">${prop.title}</div>
              <div class="text-[11px] text-slate-400 font-mono flex items-center gap-2 mt-0.5">
                <span class="bg-slate-100 px-1.5 py-0.2 rounded">${prop.id}</span>
                <span>${prop.address}</span>
              </div>
            </td>

            <td class="p-3.5 font-mono font-bold text-slate-800">
              <div>${window.OmidDashboard.formatToman(prop.priceToman)}</div>
              <div class="text-[10px] text-slate-400 font-normal">متری ${window.OmidDashboard.formatNumber(prop.pricePerMeterToman)} ت</div>
            </td>

            <td class="p-3.5">
              <div class="font-medium text-slate-700">${prop.areaSqm} متر مربع</div>
              <div class="text-[11px] text-slate-400">${prop.bedrooms} خواب • ${prop.propertyTypeLabel}</div>
            </td>

            <!-- ستون مشخصات مشاور مسئول -->
            <td class="p-3.5">
              <div class="flex items-center gap-2.5">
                <img src="${prop.advisor.avatar}" alt="${prop.advisor.name}" class="w-8 h-8 rounded-full object-cover border border-slate-200" />
                <div>
                  <div class="font-bold text-slate-900 flex items-center gap-1.5">
                    <span>${prop.advisor.name}</span>
                    ${isMine ? '<span class="bg-accent-100 text-accent-800 text-[9px] px-1.5 py-0.2 rounded font-bold">خودم</span>' : ''}
                  </div>
                  <div class="text-[10px] text-slate-400 font-mono" dir="ltr">${prop.advisor.phone}</div>
                </div>
              </div>
            </td>

            <td class="p-3.5">
              <span class="px-2.5 py-1 rounded-lg text-[11px] font-bold ${
                prop.status === 'available'
                  ? 'bg-emerald-100 text-emerald-800 border border-emerald-200'
                  : prop.status === 'negotiating'
                  ? 'bg-amber-100 text-amber-800 border border-amber-200'
                  : 'bg-slate-200 text-slate-700'
              }">
                ${prop.statusLabel}
              </span>
            </td>

            <!-- ستون عملیات مدیریتی -->
            <td class="p-3.5 text-center whitespace-nowrap">
              <div class="flex items-center justify-center gap-1.5 whitespace-nowrap">
                ${
                  canEdit
                    ? `<button
                        type="button"
                        data-action="edit"
                        data-id="${prop.id}"
                        class="px-2.5 py-1 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 font-bold text-[11px] transition-colors whitespace-nowrap shrink-0 inline-flex items-center gap-1"
                        title="ویرایش مشخصات"
                      >
                        <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                          <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                        </svg>
                        <span>ویرایش</span>
                      </button>`
                    : ''
                }

                ${
                  canDelete
                    ? `<button
                        type="button"
                        data-action="delete"
                        data-id="${prop.id}"
                        data-title="${prop.title}"
                        class="px-2.5 py-1 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold text-[11px] transition-colors whitespace-nowrap shrink-0 inline-flex items-center gap-1"
                        title="حذف ملک"
                      >
                        <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                        <span>حذف</span>
                      </button>`
                    : ''
                }

                <a
                  href="${window.location.origin}${baseUrl}/properties/${prop.slug}/"
                  target="_blank"
                  class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold text-[11px] transition-colors whitespace-nowrap shrink-0 inline-flex items-center gap-1"
                  title="مشاهده صفحه ملک در سایت"
                >
                  <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M10 12a2 2 0 100-4 2 2 0 000 4z" />
                    <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" />
                  </svg>
                  <span>سایت</span>
                </a>
              </div>
            </td>
          </tr>
        `;
      }).join('');

      // اتصال رویدادهای دکمه‌های جدول
      tbody.querySelectorAll('button[data-action="edit"]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          openEditModal(id);
        });
      });

      tbody.querySelectorAll('button[data-action="delete"]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          const title = btn.getAttribute('data-title');
          if (confirm(`آیا از حذف دائم فایل ملکی "${title}" اطمینان دارید؟\nاین عملیات غیرقابل بازگشت است.`)) {
            window.OmidDashboard.deleteProperty(id);
            window.OmidDashboard.showToast(`ملک "${title}" با موفقیت حذف گردید.`, 'success');
            renderProperties();
          }
        });
      });
    }

    // باز کردن مودال ویرایش
    function openEditModal(propId) {
      const prop = window.OmidDashboard.getPropertyById(propId);
      if (!prop) return;

      document.getElementById('editPropId').value = prop.id;
      document.getElementById('editPropIdBadge').innerText = `کد: ${prop.id}`;
      document.getElementById('editTitle').value = prop.title;
      document.getElementById('editPrice').value = prop.priceToman;
      document.getElementById('editArea').value = prop.areaSqm;
      document.getElementById('editStatus').value = prop.status;
      document.getElementById('editBedrooms').value = prop.bedrooms || 3;
      document.getElementById('editAddress').value = prop.address;

      const advSelect = document.getElementById('editAdvisorSelect');
      if (advSelect) {
        advSelect.value = prop.advisor.id;
        // اگر مشاور عادی است، انتخاب مشاور غیرفعال شود
        if (!isStaff) {
          document.getElementById('editAdvisorContainer').style.display = 'none';
        } else {
          document.getElementById('editAdvisorContainer').style.display = 'block';
        }
      }

      document.getElementById('editPropModal').classList.remove('hidden');
    }

    // ذخیره فرم ویرایش
    document.getElementById('editPropertyForm')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const id = document.getElementById('editPropId').value;
      const data = {
        title: document.getElementById('editTitle').value,
        priceToman: Number(document.getElementById('editPrice').value),
        areaSqm: Number(document.getElementById('editArea').value),
        status: document.getElementById('editStatus').value,
        bedrooms: Number(document.getElementById('editBedrooms').value),
        address: document.getElementById('editAddress').value,
      };

      if (isStaff) {
        data.advisorId = document.getElementById('editAdvisorSelect').value;
      }

      window.OmidDashboard.updateProperty(id, data);
      window.OmidDashboard.showToast('تغییرات ملک با موفقیت در سیستم اعمال گردید.', 'success');
      document.getElementById('editPropModal').classList.add('hidden');
      renderProperties();
    });

    // رویدادهای مودال ثبت جدید
    const newModal = document.getElementById('newPropModal');
    document.getElementById('openNewPropBtn')?.addEventListener('click', () => newModal.classList.remove('hidden'));
    document.getElementById('cancelNewPropBtn')?.addEventListener('click', () => newModal.classList.add('hidden'));
    document.getElementById('closeNewModalX')?.addEventListener('click', () => newModal.classList.add('hidden'));

    // بستن مودال ویرایش
    const editModal = document.getElementById('editPropModal');
    document.getElementById('cancelEditPropBtn')?.addEventListener('click', () => editModal.classList.add('hidden'));
    document.getElementById('closeEditModalX')?.addEventListener('click', () => editModal.classList.add('hidden'));

    // ثبت ملک جدید
    document.getElementById('newPropertyForm')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const newPropData = {
        title: document.getElementById('newTitle').value,
        priceToman: Number(document.getElementById('newPrice').value),
        areaSqm: Number(document.getElementById('newArea').value),
        propertyType: document.getElementById('newType').value,
        bedrooms: Number(document.getElementById('newBedrooms').value),
        address: document.getElementById('newAddress').value,
      };

      if (isStaff) {
        newPropData.advisorId = document.getElementById('newAdvisorSelect').value;
      } else {
        newPropData.advisorId = currentUser.id;
      }

      window.OmidDashboard.createProperty(newPropData);
      window.OmidDashboard.showToast('ملک جدید با موفقیت ثبت و به لیست افزوده شد.', 'success');
      newModal.classList.add('hidden');
      document.getElementById('newPropertyForm').reset();
      renderProperties();
    });

    // فیلترها و جستجو
    document.getElementById('propSearchInput')?.addEventListener('input', renderProperties);
    document.getElementById('advisorFilterSelect')?.addEventListener('change', renderProperties);
    document.getElementById('statusFilterSelect')?.addEventListener('change', renderProperties);
    document.getElementById('typeFilterSelect')?.addEventListener('change', renderProperties);

    // اجرای رندر اولیه
    renderProperties();
  });
</script>
