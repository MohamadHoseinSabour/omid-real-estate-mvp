---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

const sampleLeads = [
  {
    id: 'lead-01',
    fullName: 'کامران بهرامی',
    phone: '۰۹۱۶۲۳۴۵۶۷۸',
    requestType: 'خرید آپارتمان',
    intent: 'buy',
    source: 'homepage_hero',
    sourceLabel: 'دکمه هیرو صفحه اصلی',
    propertyTitle: 'آپارتمان ۱۶۵ متری اردیبهشت',
    budget: '۴ تا ۵ میلیارد تومان',
    status: 'new',
    statusLabel: 'جدید (پیگیری نشده)',
    createdAt: '۱۴۰۳/۰۷/۱۶ - ۱۰:۳۰'
  },
  {
    id: 'lead-02',
    fullName: 'فاطمه ناصری',
    phone: '۰۹۱۶۹۸۷۶۵۴۳',
    requestType: 'فروش ملک',
    intent: 'sell',
    source: 'consult_form',
    sourceLabel: 'فرم مشاوره مسکن',
    propertyTitle: '—',
    budget: 'ویلایی ۲۵۰ متری بوستان',
    status: 'contacted',
    statusLabel: 'تماس اولیه گرفته شد',
    createdAt: '۱۴۰۳/۰۷/۱۵ - ۱۶:۴۵'
  },
  {
    id: 'lead-03',
    fullName: 'مهرداد صالحی',
    phone: '۰۹۱۶۳۴۵۶۷۸۹',
    requestType: 'استعلام ملک',
    intent: 'buy',
    source: 'property_detail_page',
    sourceLabel: 'صفحه جزئیات ملک',
    propertyTitle: 'آپارتمان ۱۱۰ متری فروردین',
    budget: '۲٫۸ میلیارد',
    status: 'converted',
    statusLabel: 'جلسه حضوری هماهنگ شد',
    createdAt: '۱۴۰۳/۰۷/۱۴ - ۱۱:۱۵'
  }
];
---

<DashboardLayout title="باشگاه لیدها و متقاضیان" activeNav="leads">
  <div class="mb-8">
    <h1 class="text-2xl font-black text-slate-900">باشگاه متقاضیان و سرنخ‌ها (Leads)</h1>
    <p class="text-xs text-slate-500 mt-1">کلیه درخواست‌های ثبت‌شده از فرم‌های وبسایت به همراه رهگیری مبدأ ورودی</p>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-xs text-start">
        <thead class="bg-slate-50 text-slate-500 font-bold border-b border-slate-200">
          <tr>
            <th class="p-3.5 text-start whitespace-nowrap">متقاضی / شماره همراه</th>
            <th class="p-3.5 text-start whitespace-nowrap">نوع تقاضا</th>
            <th class="p-3.5 text-start whitespace-nowrap">مبدأ ثبت (Source)</th>
            <th class="p-3.5 text-start whitespace-nowrap">ملک یا بودجه مدنظر</th>
            <th class="p-3.5 text-start whitespace-nowrap">وضعیت پیگیری</th>
            <th class="p-3.5 text-start whitespace-nowrap">تاریخ ثبت</th>
            <th class="p-3.5 text-start whitespace-nowrap">اقدام</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {sampleLeads.map((lead) => (
            <tr class="hover:bg-slate-50/70 transition-colors">
              <td class="p-3.5">
                <div class="font-bold text-slate-900">{lead.fullName}</div>
                <div class="text-[11px] text-slate-400 font-mono" dir="ltr">{lead.phone}</div>
              </td>
              <td class="p-3.5">
                <span class="inline-block px-2 py-0.5 rounded bg-primary-100 text-primary-800 font-semibold whitespace-nowrap">
                  {lead.requestType}
                </span>
              </td>
              <td class="p-3.5 text-slate-500">
                <span class="inline-block px-2 py-0.5 rounded bg-slate-100 border text-[11px] whitespace-nowrap">
                  {lead.sourceLabel}
                </span>
              </td>
              <td class="p-3.5 text-slate-700">
                {lead.propertyTitle !== '—' ? lead.propertyTitle : lead.budget}
              </td>
              <td class="p-3.5">
                <span class={`px-2 py-0.5 rounded-full font-bold text-[11px] whitespace-nowrap ${lead.status === 'new' ? 'bg-amber-100 text-amber-800' : lead.status === 'contacted' ? 'bg-blue-100 text-blue-800' : 'bg-emerald-100 text-emerald-800'}`}>
                  {lead.statusLabel}
                </span>
              </td>
              <td class="p-3.5 text-slate-400 font-mono whitespace-nowrap">
                {lead.createdAt}
              </td>
              <td class="p-3.5 whitespace-nowrap">
                <button
                  type="button"
                  onclick="alert('امکان تغییر وضعیت لید و ثبت یادداشت پیگیری ذخیره شد.')"
                  class="px-2.5 py-1 rounded-lg border border-slate-300 hover:bg-slate-100 text-slate-700 font-bold whitespace-nowrap shrink-0"
                >
                  پیگیری
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</DashboardLayout>
